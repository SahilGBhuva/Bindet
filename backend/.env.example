# Database. Leave DATABASE_URL unset to use local SQLite (local dev and tests only).
# Production (VERCEL set, or APP_ENV=production) refuses to start without a PostgreSQL DATABASE_URL.
# For Supabase/Vercel, prefer the transaction pooler URI (port 6543).
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Set to production on non-Vercel hosts to enforce the DATABASE_URL requirement.
APP_ENV=

# Optional local SQLite override. POCKET_TUTOR_DB_PATH remains supported for legacy/test setups.
BINDIT_DB_PATH=

# Supabase project settings used for authentication.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-images

# Backend-only AI settings (Groq). Never expose this key in frontend code.
# Get a key at https://console.groq.com/keys (the account owner must be 18+). The free plan
# never charges: past its limits Groq answers 429 and bindet shows "try again shortly".
GROQ_API_KEY=
# Models per job (optional; these are the defaults). Each Groq model has its own free limits,
# so bindet spreads its jobs over several. All must be Groq model IDs; on the free plan
# that means openai/gpt-oss-20b, openai/gpt-oss-120b and qwen/qwen3.8-27b (Llama needs a sales deal).
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_LONG_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_SMALL_MODEL=openai/gpt-oss-20b
# When a model is rate limited, try one other free Groq model. Set to off to disable.
AI_FALLBACKS=
# Fast failure budgets. Warm requests reuse one HTTP/2 connection for up to five minutes.
AI_TIMEOUT_SECONDS=12
AI_VISION_TIMEOUT_SECONDS=15
# The longest wait between streamed chunks of an Otto reply.
AI_STREAM_IDLE_SECONDS=25
# Every AI call across all accounts per day (default 2500, sized for Groq's free plan).
AI_DAILY_GLOBAL_LIMIT=
# Optional server secret that keys the student pseudonyms in AI operation logs, so the
# logs can't be matched to user IDs without it. Leave empty to keep the unkeyed hash.
LOG_HASH_SALT=

# Comma-separated emails. Owner accounts (confirmed email) have no per-student usage limits;
# the site-wide AI_DAILY_GLOBAL_LIMIT and a 120/minute burst cap still apply.
OWNER_EMAILS=
# Comma-separated emails that can read in-app feedback at /#admin.
ADMIN_EMAILS=
